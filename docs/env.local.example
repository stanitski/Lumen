LUMEN_ENV=development
LUMEN_USER_ID=VST
LOG_LEVEL=DEBUG
LUMEN_HOST=127.0.0.1
LUMEN_PORT=8010
LUMEN_DB_PATH=./data/lumen.db

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CLIENT_KEEP_ALIVE=30m
OLLAMA_DEBUG_DUMP_PATH=./data/debug/last_ollama_request.json

DIALOGUE_MEMORY_WINDOW_HOURS=3
ENABLE_REMINDER_WAKE_TIMER=true
REMINDER_WAKE_LEAD_SECONDS=120

HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=PUT_HOME_ASSISTANT_LONG_LIVED_TOKEN_HERE
HOME_ASSISTANT_WEBHOOK_ID=lumen_hook_f8e9d2a1
HOME_ASSISTANT_WEBHOOK_URL=

KNOWLEDGE_PATHS=./data/knowledge
