# Override only the values that differ from src/lumen/config.py defaults.
LUMEN_ENV=development
LUMEN_USER_ID=VST
LOG_LEVEL=DEBUG
LUMEN_HOST=0.0.0.0
LUMEN_PORT=8010
LUMEN_DB_PATH=./data/lumen.db

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_DIALOGUE_MODEL=
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_STREAM_IDLE_TIMEOUT_SECONDS=240
OLLAMA_CLIENT_KEEP_ALIVE=5m
OLLAMA_DEBUG_DUMP_PATH=./data/debug/last_ollama_request.json
# Default canonical Lumen user for /api/chat and /api/generate when the client does not send user_id.
OLLAMA_COMPAT_USER_ID=

DIALOGUE_MEMORY_WINDOW_HOURS=3

HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_WEBHOOK_ID=lumen_hook_f8e9d2a1
HOME_ASSISTANT_WEBHOOK_URL=
HOME_ASSISTANT_CALENDAR_ENTITY_IDS=
HOME_ASSISTANT_CALENDAR_WRITE_ENTITY_ID=
HOME_ASSISTANT_CALENDAR_TARGET_CHAT_ID=
HOME_ASSISTANT_CALENDAR_ALL_DAY_TIME=09:00
HOME_ASSISTANT_CALENDAR_RECONNECT_SECONDS=5
HOME_ASSISTANT_CALENDAR_DEFAULT_DURATION_MINUTES=60

KNOWLEDGE_PATHS=./data/knowledge

# Telegram context lookup uses a local MTProto user session.
# Create the session with a local login flow; do not send Telegram passwords through chat.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telegram/lumen
TELEGRAM_DEFAULT_MESSAGE_LIMIT=30
TELEGRAM_CHANNEL_HISTORY_HOURS=4
TELEGRAM_DIALOG_HISTORY_HOURS=48

# Speech-to-text for audio/voice attachments. ffmpeg is preferred for normalization;
# if it is unavailable, faster-whisper will try to decode the original file.
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=
FFMPEG_PATH=ffmpeg
